<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 11+ only answers canOpenUrl for schemes an app declares: a wallet
         for ethereum: links (EIP-681) and a browser or the Paystrater app for https -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="ethereum" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
